{
  "name": "pi-context-shake",
  "version": "1.0.5",
  "description": "pi extension: /shake tools|images|thinking — rebuilds session history in place to free context space",
  "type": "module",
  "license": "MIT",
  "author": "Islam Nofl",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context",
    "compaction",
    "history"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corrm/pi-context-shake"
  },
  "files": [
    "index.ts",
    "auto-recovery.ts"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --no-env-file test.ts && bun test auto-recovery.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
